{
  "name": "@tryvitris/website-admin-harness",
  "version": "1.6.0",
  "type": "module",
  "license": "MIT",
  "description": "Cloudflare business admin runtime and agent kit",
  "exports": {
    "./prototypes/client-onboarding": {
      "types": "./dist/client-onboarding.d.ts",
      "default": "./dist/client-onboarding.js"
    },
    "./billing": {
      "types": "./dist/stripe-billing.d.ts",
      "default": "./dist/stripe-billing.js"
    },
    "./prototypes/billing": {
      "types": "./dist/billing-prototype.d.ts",
      "default": "./dist/billing-prototype.js"
    },
    "./prototypes/client-portfolio": {
      "types": "./dist/client-portfolio.d.ts",
      "default": "./dist/client-portfolio.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./cli": {
      "types": "./bin/admin.d.mts",
      "default": "./bin/admin.mjs"
    },
    "./pages": {
      "types": "./dist/pages.d.ts",
      "default": "./dist/pages.js"
    },
    "./account-mail": {
      "types": "./dist/account-mail.d.ts",
      "default": "./dist/account-mail.js"
    },
    "./pairing": {
      "types": "./dist/pairing.d.ts",
      "default": "./dist/pairing.js"
    },
    "./signon": {
      "types": "./dist/signon.d.ts",
      "default": "./dist/signon.js"
    },
    "./maintenance": {
      "types": "./dist/maintenance.d.ts",
      "default": "./dist/maintenance.js"
    },
    "./email-campaigns": {
      "types": "./dist/email-campaigns.d.ts",
      "default": "./dist/email-campaigns.js"
    },
    "./email-campaigns/website": {
      "types": "./dist/email-website.d.ts",
      "default": "./dist/email-website.js"
    },
    "./email-campaigns/signup": {
      "types": "./dist/email-signup.d.ts",
      "default": "./dist/email-signup.js"
    }
  },
  "bin": {
    "vitris-admin": "bin/admin.mjs"
  },
  "files": [
    "dist/client-onboarding.js",
    "dist/client-onboarding.d.ts",
    "dist/stripe-billing.js",
    "dist/stripe-billing.d.ts",
    "dist/stripe-billing-env.d.ts",
    "modules",
    "dist/billing-prototype.js",
    "dist/billing-prototype.d.ts",
    "dist/client-portfolio.js",
    "dist/client-portfolio.d.ts",
    "prototypes",
    "dist/worker.js",
    "dist/worker.d.ts",
    "dist/harness.d.ts",
    "dist/calendar.d.ts",
    "dist/booking.d.ts",
    "dist/accounts.d.ts",
    "dist/contracts",
    "dist/client",
    "migrations",
    "agent",
    "bin/*.mjs",
    "bin/*.d.mts",
    "dist/pages.js",
    "dist/pages.d.ts",
    "dist/account-mail.js",
    "dist/account-mail.d.ts",
    "dist/pairing.js",
    "dist/pairing.d.ts",
    "dist/signon.js",
    "dist/signon.d.ts",
    "vitris-release.json",
    "dist/maintenance.js",
    "dist/maintenance.d.ts",
    "dist/email-campaigns.js",
    "dist/email-campaigns.d.ts",
    "dist/email-env.d.ts",
    "dist/email-website.js",
    "dist/email-website.d.ts",
    "dist/email-signup.js",
    "dist/email-signup.d.ts",
    "docs/EMAIL-CAMPAIGNS.md"
  ],
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackperrotta/website-admin-harness.git",
    "directory": "packages/admin"
  },
  "homepage": "https://github.com/jackperrotta/website-admin-harness#readme",
  "bugs": {
    "url": "https://github.com/jackperrotta/website-admin-harness/issues"
  },
  "vitris": {
    "maintenance": {
      "version": 1,
      "policy": "prepare-and-test",
      "stableChannel": "latest",
      "command": "vitris-admin updates check --dir . --json",
      "schedule": "reuse-existing-daily-care"
    }
  }
}
