{
  "name": "@tryvitris/website-admin-contracts",
  "version": "1.8.0",
  "type": "module",
  "license": "MIT",
  "description": "Validated installation and module contracts for Cloudflare business admin apps",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./scheduling": {
      "types": "./dist/scheduling.d.ts",
      "default": "./dist/scheduling.js"
    },
    "./email-campaigns": {
      "types": "./dist/email-campaigns.d.ts",
      "default": "./dist/email-campaigns.js"
    }
  },
  "files": [
    "dist",
    "vitris-release.json"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackperrotta/website-admin-harness.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://github.com/jackperrotta/website-admin-harness#readme",
  "bugs": {
    "url": "https://github.com/jackperrotta/website-admin-harness/issues"
  },
  "vitris": {
    "maintenance": {
      "version": 1,
      "policy": "prepare-and-test",
      "stableChannel": "latest",
      "command": "vitris-admin updates check --dir . --json",
      "schedule": "reuse-existing-daily-care"
    }
  }
}
