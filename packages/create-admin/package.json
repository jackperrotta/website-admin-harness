{
  "name": "@tryvitris/create-website-admin-harness",
  "version": "1.6.0",
  "type": "module",
  "license": "MIT",
  "description": "Create a standalone Cloudflare business admin installation",
  "bin": {
    "create-website-admin-harness": "index.mjs"
  },
  "files": [
    "index.mjs",
    "vitris-release.json"
  ],
  "dependencies": {
    "@tryvitris/website-admin-harness": "1.6.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackperrotta/website-admin-harness.git",
    "directory": "packages/create-admin"
  },
  "homepage": "https://github.com/jackperrotta/website-admin-harness#readme",
  "bugs": {
    "url": "https://github.com/jackperrotta/website-admin-harness/issues"
  },
  "vitris": {
    "maintenance": {
      "version": 1,
      "policy": "prepare-and-test",
      "stableChannel": "latest",
      "command": "vitris-admin updates check --dir . --json",
      "schedule": "reuse-existing-daily-care"
    }
  }
}
