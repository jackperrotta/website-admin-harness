{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "react-jsx", "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "allowImportingTsExtensions": true, "esModuleInterop": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "examples/**/*.ts"]
}
