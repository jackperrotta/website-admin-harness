{
  "name": "website-admin-harness",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "dev": "npm run build && npm run db:local && wrangler dev --config wrangler.local.jsonc --port 4391",
    "db:local": "wrangler d1 migrations apply vitris-admin-local --local --config wrangler.local.jsonc",
    "check": "npm run build && npm run typecheck && node --test tests/*.test.mjs",
    "release:pack": "npm run check && node scripts/pack-release.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260922.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.28.1",
    "miniflare": "5.20260918.0-alpha",
    "typescript": "^5.9.2",
    "vite": "^7.0.0",
    "wrangler": "^4.135.0"
  }
}
